# Copy to repo root `.env` (gitignored). Librarian loads this automatically.

# Librarian database (path relative to tools/librarian when using daily-wiki.ps1)
LIBRARIAN_DB_PATH=.data/librarian.sqlite3

# Kimi — prefer Kimi Code CLI (subscription OAuth). Open Platform API is optional fallback.
# Default backend: auto (CLI if logged in, else API if key set)
KIMI_BACKEND=cli
# KIMI_CLI_MODEL=kimi-code/k3
# KIMI_CLI_EXE=C:\Users\you\.kimi-code\bin\kimi.exe

# Open Platform only — pay-as-you-go; NOT included in Kimi membership
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=kimi-k3
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Optional
GITHUB_TOKEN=

# Slack — breedables-slack bot + Apprise digests + GitHub Actions CI
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_NOTIFY_CHANNEL=#breedables-knowledge
# Incoming webhook — also set as GitHub secret SLACK_WEBHOOK_URL for CI notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# APPRISE_URLS=
